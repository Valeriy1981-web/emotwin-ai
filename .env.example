# ==============================================================================
# EmoTwin AI Environment Variables
# ==============================================================================

# 🔑 API КЛЮЧИ
OPENAI_API_KEY=your_openai_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here

# 🗄️ Базы данных
DATABASE_URL=postgresql://user:password@localhost/dbname
REDIS_URL=redis://localhost:6379/0

# 🌐 Сервер и API
PORT=8000
HOST=0.0.0.0
DEBUG=True

# 🔐 Безопасность
SECRET_KEY=your_secret_key_here
JWT_EXPIRES=3600

# 📊 Мониторинг
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# 🔍 Логирование
LOG_LEVEL=INFO
LOG_FILE=app.log

# 🤖 AI Модели
DEFAULT_MODEL=gpt-4o
MAX_TOKENS=2048

# 🔄 Кэширование
CACHE_ENABLED=True
CACHE_TTL=300

# 🔗 Внешние сервисы
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
